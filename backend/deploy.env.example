# ──────────────────────────────────────────────────────────────
# TenderEase — Cloud Run deploy config
# Copy to "deploy.env" and fill in real values. deploy.env is git-ignored.
#   cp deploy.env.example deploy.env
# ──────────────────────────────────────────────────────────────

# --- GCP ---
PROJECT_ID=tenderease-500911
# Singapore (asia-southeast1) is closest to your Neon DB (ap-southeast-1) → lowest latency.
# Mumbai (asia-south1) also works; just keep it consistent everywhere.
REGION=asia-southeast1
REPO=tender-images

# Per-service container resources
MEMORY=1Gi
CPU=1
MIN_INSTANCES=0          # set gateway etc. higher if cold starts bother you
MAX_INSTANCES=2

# --- PostgreSQL (Neon) ---
DB_HOST=ep-nameless-haze-ao5zyycp-pooler.c-2.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_USERNAME=neondb_owner
DB_PASSWORD=npg_wR9iIDYGj2ga

# --- Keycloak (Cloud-IAM) ---
KEYCLOAK_ISSUER_URI=https://lemur-1.cloud-iam.com/auth/realms/tenderease
KEYCLOAK_JWK_SET_URI=https://lemur-1.cloud-iam.com/auth/realms/tenderease/protocol/openid-connect/certs

# --- RabbitMQ (CloudAMQP) ---
# From your CloudAMQP instance page. For a free "Little Lemur" instance the
# username and the virtual host are the SAME value. Port is 5671 (TLS).
RABBITMQ_HOST=xxxxx.rmq.cloudamqp.com
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=yourvhost
RABBITMQ_PASSWORD=yourpassword
RABBITMQ_VHOST=yourvhost
RABBITMQ_SSL=true

# --- Frontend CORS origins (comma-separated, no spaces) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
